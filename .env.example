# KOKi.ai — environment variables
# All keys are optional. The app degrades to a deterministic mock if no
# LLM provider is set, so you can develop the UI without keys.

# ── LLM providers ─────────────────────────────────────────────────────────
# KOKi.ai is "Grok-first": the router calls xAI Grok when XAI_API_KEY is set,
# then Anthropic, then OpenAI, then mock. The UI always shows which provider
# actually served the request — we never claim a model that didn't run.

# xAI Grok (PRIMARY) — get a key at https://console.x.ai
XAI_API_KEY=
# Default flagship model for Generate Launch Kit (highest quality, highest cost).
XAI_MODEL=grok-4-latest
# Fast variant used by Analyze, Monitor, X-Post, Wallet brief (cheaper, faster).
XAI_MODEL_FAST=grok-4-fast-reasoning
# XAI_BASE_URL=https://api.x.ai/v1   # only override for self-hosted gateways

# Anthropic Claude (FALLBACK)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (FALLBACK of the fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Robinhood Chain / Pons (Pons Launch Agent) ────────────────────────────
# Pons is non-custodial — no API key required. The user's wallet signs
# every launch straight to the factory contract. See lib/pons/constants.ts
# for the deployed addresses.

# Robinhood Chain RPC (id 4663).
# Public RPC works for reads; use a paid RPC for heavy indexing.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WalletConnect Cloud project id — required for RainbowKit's mobile flow
# (Robinhood Wallet, Rainbow, Trust, Zerion pair through WalletConnect).
# Free tier is fine. Get one at https://cloud.walletconnect.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── X (Twitter) API ───────────────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# ── Telegram Bot API ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Supabase (launch history + memes cache) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
